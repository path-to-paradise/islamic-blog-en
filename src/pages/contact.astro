---
import BaseLayout from "../layouts/BaseLayout.astro";

const CONTACT_EMAIL = "noorandknowledge@atomicmail.io";
---

<BaseLayout title="Contact" description="Get in touch with Noor & Knowledge.">
  <article class="post-content">
    <h1>Contact</h1>
    <p>
      Spotted an error, have a correction, or a topic you'd like to see covered? Reach out —
      every message is read.
    </p>
    <p>
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </p>
  </article>
</BaseLayout>
