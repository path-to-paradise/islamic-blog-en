---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// sizeKb is set by hand (rather than read from disk at build time) so this page
// has no Node built-in dependencies — some hosts bundle pages for a non-Node
// runtime (e.g. Cloudflare Workers), where `node:fs` can't be resolved.
const resources = [
  {
    file: "daily-prayer-tracker.pdf",
    title: "Daily Prayer Tracker",
    description: "A printable weekly checklist for the five daily prayers.",
    sizeKb: 2,
  },
  {
    file: "gratitude-journal-prompts.pdf",
    title: "Gratitude Journal Prompts",
    description: "Ten prompts for a short daily gratitude practice.",
    sizeKb: 2,
  },
  {
    file: "ramadan-planning-worksheet.pdf",
    title: "Ramadan Planning Worksheet",
    description: "A one-page worksheet for planning the month ahead.",
    sizeKb: 2,
  },
  {
    file: "recommended-reading-list.pdf",
    title: "Recommended Reading List",
    description: "A template for curating your own trusted reading list.",
    sizeKb: 1,
  },
];
---

<BaseLayout title="Downloads" description="Free downloadable resources from Noor & Knowledge.">
  <h1>Downloads</h1>
  <p class="search-intro">
    Free printable resources — save them, print them, or use them as a starting point for your
    own.
  </p>

  <ul class="download-list">
    {resources.map((resource) => (
      <li class="download-card">
        <div class="download-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22">
            <path
              d="M6 2h9l5 5v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"
            />
            <path d="M15 2v5h5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M8 13h8M8 16.5h8M8 9.5h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </div>
        <div class="download-info">
          <h2>{resource.title}</h2>
          <p>{resource.description}</p>
        </div>
        <a class="download-btn" href={`${base}/downloads/${resource.file}`} download>
          <span>Download</span>
          <span class="download-meta">PDF · {resource.sizeKb} KB</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="search-intro" style="margin-top: 2rem;">
    These are sample placeholder files — replace them in <code>public/downloads/</code> with
    your own resources.
  </p>
</BaseLayout>
